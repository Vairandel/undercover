{
  "name": "undercover-lan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Undercover party game, self-hosted on your LAN. Themed word bank, pluggable roles, no internet required.",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"node --watch server/index.js\" \"npm run dev -w client\"",
    "build": "npm run build --workspace client",
    "start": "node server/index.js",
    "play": "npm run build && node server/index.js",
    "tunnel": "npm run build && node scripts/tunnel.mjs",
    "firewall": "powershell -ExecutionPolicy Bypass -File scripts/allow-firewall.ps1",
    "words:stats": "node scripts/word-stats.js"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
